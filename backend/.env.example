# Copy this file to `.env` in the backend/ directory for local development.
# Never commit the real `.env` file.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string. Use a local Postgres instance in development;
# the hosting provider injects the production value directly.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crypto_advisor

# JWT signing secret -- generate a long random string, never reuse this
# placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# CoinGecko's free tier does not require a key for basic endpoints.
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# CryptoPanic API key (free tier). Leave empty to force the static news
# fallback.
CRYPTOPANIC_API_KEY=

# OpenRouter API key used for AI insight generation. Leave empty to force
# the safe fallback insight.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
