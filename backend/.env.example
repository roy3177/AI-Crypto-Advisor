# Copy this file to `.env` in the backend/ directory for local development.
# Never commit the real `.env` file.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string. Use a local Postgres instance in development;
# the hosting provider injects the production value directly.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crypto_advisor

# JWT signing secret -- generate a long random string, never reuse this
# placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# CoinGecko's free "Demo" tier does not require a key for /simple/price.
# An optional key only raises the rate limit -- leave empty to run keyless.
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# CryptoPanic API key (free tier -- sign up at https://cryptopanic.com/developers/api/).
# Leave empty to force the static news fallback (this is a fully supported,
# honestly-labeled state, not an error).
CRYPTOPANIC_API_KEY=

# CryptoPanic's base URL includes an account-plan segment shown on YOUR
# dashboard after signing up (e.g. ".../api/free/v2" or ".../api/developer/v2").
# Only change this if your dashboard shows a different plan segment.
CRYPTOPANIC_API_BASE=https://cryptopanic.com/api/free/v2

# OpenRouter API key used for AI insight generation (sign up free at
# https://openrouter.ai/keys). Leave empty to force the safe fallback
# insight -- this is a fully supported state, not an error.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Free-tier model availability on OpenRouter rotates -- verify this is
# still free at https://openrouter.ai/models?max_price=0 before relying on it.
AI_MODEL=google/gemma-4-31b-it:free
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=300
